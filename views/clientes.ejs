<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clientes — <%= usuario.restaurante %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #09090b; color: #e4e4e7; display: flex; min-height: 100vh; }

    /* SIDEBAR */
    .sidebar { width: 240px; background: #0c0c0f; border-right: 1px solid #18181b; display: flex; flex-direction: column; padding: 0; position: fixed; height: 100vh; z-index: 100; }
    .sidebar-logo { padding: 24px 20px 20px; border-bottom: 1px solid #18181b; }
    .sidebar-logo .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .sidebar-logo .brand-icon { width: 32px; height: 32px; background: linear-gradient(135deg, #7c3aed, #4f46e5); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
    .sidebar-logo .brand-name { font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -0.3px; }
    .sidebar-logo .brand-rest { font-size: 11px; color: #52525b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-left: 42px; }
    .sidebar-menu { padding: 12px 10px; flex: 1; }
    .sidebar-section { font-size: 10px; font-weight: 600; color: #3f3f46; text-transform: uppercase; letter-spacing: 1px; padding: 8px 10px 4px; margin-top: 8px; }
    .menu-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; color: #71717a; font-size: 13px; font-weight: 500; cursor: pointer; margin-bottom: 1px; text-decoration: none; transition: all .15s; position: relative; }
    .menu-item:hover { background: #18181b; color: #d4d4d8; }
    .menu-item.active { background: rgba(124,58,237,.12); color: #a78bfa; }
    .menu-item.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; background: linear-gradient(180deg, #7c3aed, #4f46e5); border-radius: 0 3px 3px 0; }
    .menu-icon { font-size: 15px; width: 20px; text-align: center; }
    .sidebar-footer { padding: 14px 16px; border-top: 1px solid #18181b; }
    .avatar { display: flex; align-items: center; gap: 10px; }
    .avatar-circle { width: 34px; height: 34px; background: linear-gradient(135deg, #7c3aed33, #4f46e533); border: 1px solid #7c3aed44; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #a78bfa; font-weight: 700; font-size: 13px; flex-shrink: 0; }
    .avatar-name { font-size: 12px; font-weight: 500; color: #d4d4d8; }
    .avatar-email { font-size: 11px; color: #52525b; }
    .logout { color: #52525b; font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px; margin-top: 12px; padding: 6px 0; transition: color .15s; }
    .logout:hover { color: #f87171; }

    /* MAIN */
    .main { margin-left: 240px; flex: 1; padding: 32px; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; }
    .page-header h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: #fafafa; }
    .page-header p { color: #52525b; font-size: 13px; margin-top: 4px; }

    /* STATS */
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
    .stat {
      background: #0f0f12; border: 1px solid #1c1c22; border-radius: 12px; padding: 20px 22px;
      transition: border-color .2s, transform .2s;
    }
    .stat:hover { border-color: #2a2a35; transform: translateY(-1px); }
    .stat-label { font-size: 11px; font-weight: 600; color: #52525b; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px; }
    .stat-value { font-size: 32px; font-weight: 700; color: #fafafa; letter-spacing: -1px; }
    .stat-value.accent { background: linear-gradient(135deg, #a78bfa, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-sub { font-size: 12px; color: #3f3f46; margin-top: 4px; }

    /* TABLE */
    .tabla-card { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 12px; overflow: hidden; }
    .tabla-header { padding: 18px 22px; border-bottom: 1px solid #1c1c22; display: flex; justify-content: space-between; align-items: center; }
    .tabla-header h3 { font-size: 14px; font-weight: 600; color: #fafafa; }
    .tabla-count { font-size: 12px; color: #52525b; background: #18181b; padding: 3px 10px; border-radius: 20px; }
    table { width: 100%; border-collapse: collapse; }
    th { color: #52525b; padding: 10px 22px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 600; border-bottom: 1px solid #1c1c22; }
    td { padding: 13px 22px; border-bottom: 1px solid #18181b; font-size: 13px; color: #71717a; cursor: pointer; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #18181b; }
    .nombre-td { color: #d4d4d8; font-weight: 500; }
    .badge { background: rgba(124,58,237,.15); color: #a78bfa; border: 1px solid rgba(124,58,237,.25); padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .canal-pill { padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
    .canal-llamada { background: rgba(124,58,237,.1); color: #a78bfa; border: 1px solid rgba(124,58,237,.2); }
    .canal-whatsapp { background: rgba(22,163,74,.1); color: #4ade80; border: 1px solid rgba(22,163,74,.2); }
    .canal-manual { background: #18181b; color: #71717a; border: 1px solid #27272a; }
    .empty { text-align: center; padding: 60px; color: #3f3f46; font-size: 14px; }
  </style>
</head>
<body>
  <div class="sidebar">
    <div class="sidebar-logo">
      <div class="brand">
        <div class="brand-icon">🤖</div>
        <div class="brand-name">ReservasBot</div>
      </div>
      <div class="brand-rest"><%= usuario.restaurante %></div>
    </div>
    <div class="sidebar-menu">
      <% if (usuario.rol === 'admin') { %>
        <a href="/admin" class="menu-item"><span class="menu-icon">🔧</span> Admin</a>
      <% } %>
      <div class="sidebar-section">Gestión</div>
      <a href="/panel" class="menu-item"><span class="menu-icon">📅</span> Reservas</a>
      <a href="/clientes" class="menu-item active"><span class="menu-icon">👥</span> Clientes</a>
      <a href="/configuracion" class="menu-item"><span class="menu-icon">⚙️</span> Configuración</a>
    </div>
    <div class="sidebar-footer">
      <div class="avatar">
        <div class="avatar-circle"><%= usuario.nombre.charAt(0).toUpperCase() %></div>
        <div style="flex:1;min-width:0;">
          <div class="avatar-name"><%= usuario.nombre %></div>
          <div class="avatar-email"><%= usuario.email %></div>
        </div>
      </div>
      <a href="/logout" class="logout">↩ Cerrar sesión</a>
    </div>
  </div>

  <div class="main">
    <div class="page-header">
      <div>
        <h1>Clientes</h1>
        <p>Historial de clientes que han reservado en tu restaurante</p>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-label">Clientes totales</div>
        <div class="stat-value accent"><%= clientes.length %></div>
        <div class="stat-sub">registrados</div>
      </div>
      <div class="stat">
        <div class="stat-label">Recurrentes</div>
        <div class="stat-value"><%= clientes.filter(c => c.total_reservas > 1).length %></div>
        <div class="stat-sub">más de 1 reserva</div>
      </div>
      <div class="stat">
        <div class="stat-label">Total reservas</div>
        <div class="stat-value"><%= clientes.reduce((a, c) => a + parseInt(c.total_reservas), 0) %></div>
        <div class="stat-sub">entre todos los clientes</div>
      </div>
    </div>

    <div class="tabla-card">
      <div class="tabla-header">
        <h3>Todos los clientes</h3>
        <span class="tabla-count"><%= clientes.length %> registros</span>
      </div>
      <table>
        <thead>
          <tr><th>#</th><th>Nombre</th><th>Teléfono</th><th>Reservas</th><th>Última visita</th><th>Canal</th></tr>
        </thead>
        <tbody>
          <% if (clientes.length === 0) { %>
            <tr><td colspan="6" class="empty">No hay clientes todavía</td></tr>
          <% } else { %>
            <% clientes.forEach((c, i) => { %>
              <tr onclick="window.location='/clientes/<%= c.id %>'">
                <td><%= i + 1 %></td>
                <td class="nombre-td"><%= c.nombre || 'Sin nombre' %></td>
                <td><%= c.telefono %></td>
                <td><span class="badge"><%= c.total_reservas %></span></td>
                <td><%= new Date(c.ultima_visita).toLocaleDateString('es-ES') %></td>
                <td>
                  <% if (c.canal_frecuente === 'whatsapp') { %>
                    <span class="canal-pill canal-whatsapp">WhatsApp</span>
                  <% } else if (c.canal_frecuente === 'manual') { %>
                    <span class="canal-pill canal-manual">Presencial</span>
                  <% } else { %>
                    <span class="canal-pill canal-llamada">Llamada</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
