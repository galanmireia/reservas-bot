<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clientes — <%= usuario.restaurante %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --bg:#030308; --glass:rgba(255,255,255,0.032); --glass-h:rgba(255,255,255,0.055);
      --gb:rgba(255,255,255,0.07); --gbh:rgba(139,92,246,0.4);
      --t:rgba(255,255,255,0.92); --t2:rgba(255,255,255,0.45); --t3:rgba(255,255,255,0.18);
      --acc:#8b5cf6; --sw:230px; --r:18px;
    }
    body { font-family:'Inter',-apple-system,sans-serif; background:var(--bg); color:var(--t); display:flex; min-height:100vh; -webkit-font-smoothing:antialiased; }

    .orb { position:fixed; border-radius:50%; filter:blur(120px); pointer-events:none; z-index:0; }
    .orb-1 { width:700px; height:700px; background:radial-gradient(circle,rgba(124,58,237,0.1) 0%,transparent 70%); top:-200px; left:-150px; animation:d1 22s ease-in-out infinite; }
    .orb-2 { width:500px; height:500px; background:radial-gradient(circle,rgba(79,70,229,0.08) 0%,transparent 70%); bottom:-100px; right:-100px; animation:d2 28s ease-in-out infinite; }
    @keyframes d1{0%,100%{transform:translate(0,0)}50%{transform:translate(50px,40px)}}
    @keyframes d2{0%,100%{transform:translate(0,0)}50%{transform:translate(-40px,-30px)}}

    .sidebar { width:var(--sw); background:rgba(255,255,255,0.018); backdrop-filter:blur(60px); -webkit-backdrop-filter:blur(60px); border-right:1px solid var(--gb); display:flex; flex-direction:column; position:fixed; height:100vh; z-index:100; }
    .sidebar-top { padding:28px 20px 20px; border-bottom:1px solid var(--gb); }
    .brand { display:flex; align-items:center; gap:11px; margin-bottom:4px; }
    .brand-mark { width:34px; height:34px; flex-shrink:0; background:linear-gradient(135deg,#8b5cf6,#6366f1); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:16px; box-shadow:0 4px 16px rgba(139,92,246,0.4); }
    .brand-name { font-size:15px; font-weight:700; letter-spacing:-0.4px; color:#fff; }
    .brand-rest { font-size:11px; color:var(--t2); padding-left:45px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sidebar-nav { padding:14px 12px; flex:1; display:flex; flex-direction:column; gap:2px; }
    .nav-label { font-size:9px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:var(--t3); padding:10px 10px 4px; margin-top:6px; }
    .nav-item { display:flex; align-items:center; gap:10px; padding:9px 12px; border-radius:12px; color:var(--t2); font-size:13px; font-weight:500; text-decoration:none; transition:all 0.2s cubic-bezier(0.4,0,0.2,1); }
    .nav-item:hover { background:var(--glass-h); color:var(--t); }
    .nav-item.active { background:rgba(139,92,246,0.15); color:#c4b5fd; box-shadow:inset 0 0 0 1px rgba(139,92,246,0.25); }
    .nav-icon { font-size:15px; width:20px; text-align:center; flex-shrink:0; }
    .sidebar-foot { padding:16px 16px 20px; border-top:1px solid var(--gb); }
    .user-row { display:flex; align-items:center; gap:10px; }
    .user-avatar { width:32px; height:32px; border-radius:50%; flex-shrink:0; background:linear-gradient(135deg,rgba(139,92,246,0.3),rgba(99,102,241,0.3)); border:1px solid rgba(139,92,246,0.3); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; color:#c4b5fd; }
    .user-name { font-size:12px; font-weight:600; color:var(--t); }
    .user-email { font-size:11px; color:var(--t3); }
    .sign-out { display:flex; align-items:center; gap:5px; margin-top:10px; font-size:11px; color:var(--t3); text-decoration:none; padding:5px 2px; transition:color 0.2s; }
    .sign-out:hover { color:#fca5a5; }

    .main { margin-left:var(--sw); flex:1; min-height:100vh; padding:36px 36px 60px; position:relative; z-index:1; }

    .header { margin-bottom:36px; }
    .header-eyebrow { font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:var(--t3); margin-bottom:6px; }
    .header-title { font-size:28px; font-weight:800; letter-spacing:-0.8px; }
    .header-sub { font-size:13px; color:var(--t2); margin-top:5px; }

    .stats { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:28px; }
    .stat { background:var(--glass); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); border:1px solid var(--gb); border-radius:var(--r); padding:24px 22px; transition:all 0.3s cubic-bezier(0.4,0,0.2,1); }
    .stat:hover { background:var(--glass-h); border-color:var(--gbh); transform:translateY(-2px); box-shadow:0 20px 60px rgba(0,0,0,0.4),0 0 80px rgba(139,92,246,0.05); }
    .stat-label { font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:var(--t3); margin-bottom:12px; }
    .stat-value { font-size:44px; font-weight:800; letter-spacing:-2px; line-height:1; color:var(--t); }
    .stat-value.purple { background:linear-gradient(135deg,#c4b5fd,#a78bfa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .stat-sub { font-size:11px; color:var(--t3); margin-top:8px; font-weight:500; }

    .tcard { background:var(--glass); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); border:1px solid var(--gb); border-radius:var(--r); overflow:hidden; }
    .tcard-head { padding:20px 24px; border-bottom:1px solid var(--gb); display:flex; align-items:center; justify-content:space-between; }
    .tcard-title { font-size:14px; font-weight:700; letter-spacing:-0.3px; color:var(--t); display:flex; align-items:center; gap:10px; }
    .chip { font-size:11px; font-weight:600; padding:3px 10px; border-radius:20px; background:var(--glass); border:1px solid var(--gb); color:var(--t2); }
    table { width:100%; border-collapse:collapse; }
    thead th { padding:11px 24px; text-align:left; font-size:10px; font-weight:700; letter-spacing:0.8px; text-transform:uppercase; color:var(--t3); border-bottom:1px solid var(--gb); }
    tbody td { padding:14px 24px; border-bottom:1px solid rgba(255,255,255,0.03); font-size:13px; color:var(--t2); cursor:pointer; }
    tbody tr:last-child td { border-bottom:none; }
    tbody tr:hover td { background:rgba(255,255,255,0.02); color:var(--t); }
    .td-name { font-weight:600; color:var(--t); }
    .badge { display:inline-flex; align-items:center; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; background:rgba(139,92,246,0.1); color:#c4b5fd; border:1px solid rgba(139,92,246,0.2); }
    .pill-wa { background:rgba(74,222,128,0.08); color:#86efac; border:1px solid rgba(74,222,128,0.15); padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; }
    .pill-call { background:rgba(139,92,246,0.1); color:#c4b5fd; border:1px solid rgba(139,92,246,0.18); padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; }
    .pill-manual { background:rgba(255,255,255,0.04); color:var(--t3); border:1px solid var(--gb); padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; }
    .empty-state { text-align:center; padding:60px; color:var(--t3); font-size:13px; }

    ::-webkit-scrollbar{width:5px} ::-webkit-scrollbar-track{background:transparent} ::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.08);border-radius:10px}

    .mobile-bar{display:none;position:fixed;top:0;left:0;right:0;height:56px;background:rgba(3,3,8,0.92);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border-bottom:1px solid var(--gb);z-index:200;align-items:center;justify-content:space-between;padding:0 16px;}
    .hamburger{width:36px;height:36px;border-radius:10px;background:var(--glass);border:1px solid var(--gb);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer;flex-shrink:0;}
    .hamburger span{width:16px;height:1.5px;background:rgba(255,255,255,0.6);border-radius:2px;display:block;}
    .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:149;}
    .sidebar-overlay.open{display:block;}
    .table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
    @media(max-width:768px){
      .mobile-bar{display:flex;}
      .sidebar{transform:translateX(-100%);transition:transform 0.3s cubic-bezier(0.4,0,0.2,1);z-index:150;}
      .sidebar.open{transform:translateX(0);}
      .main{margin-left:0!important;padding:72px 14px 60px!important;}
      .stats{grid-template-columns:repeat(2,1fr)!important;gap:10px;}
      .stat-value{font-size:32px!important;letter-spacing:-1px!important;}
      .tcard{overflow:visible;}
      .tcard-head{flex-direction:column;align-items:flex-start!important;gap:10px;}
    }
    @media(max-width:480px){
      .stat{padding:14px 12px;}
      .stat-value{font-size:26px!important;}
      thead th,tbody td{padding:10px 10px!important;font-size:12px;}
    }
  </style>
</head>
<body>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
  <div class="mobile-bar">
    <button class="hamburger" onclick="toggleSidebar()" aria-label="Menú"><span></span><span></span><span></span></button>
    <div style="display:flex;align-items:center;gap:8px;">
      <div style="width:28px;height:28px;background:linear-gradient(135deg,#8b5cf6,#6366f1);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;">🤖</div>
      <span style="font-size:14px;font-weight:700;color:#fff;letter-spacing:-0.3px;">ReservasBot</span>
    </div>
    <div style="width:36px;"></div>
  </div>

  <nav class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <div class="brand">
        <div class="brand-mark">🤖</div>
        <span class="brand-name">ReservasBot</span>
      </div>
      <div class="brand-rest"><%= usuario.restaurante %></div>
    </div>
    <div class="sidebar-nav">
      <% if (usuario.rol === 'admin') { %>
        <div class="nav-label">Sistema</div>
        <a href="/admin" class="nav-item"><span class="nav-icon">⚡</span> Administración</a>
      <% } %>
      <div class="nav-label">Gestión</div>
      <a href="/panel" class="nav-item"><span class="nav-icon">◼</span> Reservas</a>
      <a href="/clientes" class="nav-item active"><span class="nav-icon">◻</span> Clientes</a>
      <a href="/analiticas" class="nav-item"><span class="nav-icon">📊</span> Analíticas</a>
      <a href="/transcripciones" class="nav-item"><span class="nav-icon">🎙️</span> Transcripciones</a>
      <div class="nav-label">Ajustes</div>
      <a href="/configuracion" class="nav-item"><span class="nav-icon">◈</span> Configuración</a>
    </div>
    <div class="sidebar-foot">
      <div class="user-row">
        <div class="user-avatar"><%= usuario.nombre.charAt(0).toUpperCase() %></div>
        <div><div class="user-name"><%= usuario.nombre %></div><div class="user-email"><%= usuario.email %></div></div>
      </div>
      <a href="/logout" class="sign-out">← Cerrar sesión</a>
    </div>
  </nav>

  <main class="main">
    <div class="header">
      <div class="header-eyebrow">Base de datos</div>
      <div class="header-title">Clientes</div>
      <div class="header-sub">Historial completo de clientes que han reservado</div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-label">Clientes totales</div>
        <div class="stat-value purple"><%= clientes.length %></div>
        <div class="stat-sub">registrados</div>
      </div>
      <div class="stat">
        <div class="stat-label">Recurrentes</div>
        <div class="stat-value"><%= clientes.filter(c => c.total_reservas > 1).length %></div>
        <div class="stat-sub">más de 1 reserva</div>
      </div>
      <div class="stat">
        <div class="stat-label">Total reservas</div>
        <div class="stat-value"><%= clientes.reduce((a,c) => a + parseInt(c.total_reservas), 0) %></div>
        <div class="stat-sub">entre todos</div>
      </div>
    </div>

    <div class="tcard">
      <div class="tcard-head">
        <div class="tcard-title">Todos los clientes <span class="chip"><%= clientes.length %></span></div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:8px;background:rgba(0,0,0,0.2);border:1px solid var(--gb);border-radius:10px;padding:7px 12px;">
            <span style="font-size:12px;color:var(--t3);">⌕</span>
            <input type="text" id="buscadorClientes" placeholder="Buscar cliente…" oninput="filtrarClientes()" style="background:none;border:none;outline:none;color:var(--t);font-size:13px;width:170px;font-family:inherit;">
          </div>
        </div>
      </div>
      <div class="table-scroll"><table id="tablaClientes">
        <thead><tr><th>#</th><th>Nombre</th><th>Teléfono</th><th>Reservas</th><th>Última visita</th><th>Canal</th></tr></thead>
        <tbody>
          <% if (clientes.length === 0) { %>
            <tr><td colspan="6" class="empty-state">No hay clientes todavía</td></tr>
          <% } else { %>
            <% clientes.forEach((c, i) => { %>
              <tr onclick="window.location='/clientes/<%= c.id %>'">
                <td><%= i + 1 %></td>
                <td class="td-name"><%= c.nombre || 'Sin nombre' %></td>
                <td><%= c.telefono %></td>
                <td><span class="badge"><%= c.total_reservas %></span></td>
                <td><%= new Date(c.ultima_visita).toLocaleDateString('es-ES') %></td>
                <td>
                  <% if (c.canal_frecuente === 'whatsapp') { %><span class="pill-wa">WhatsApp</span>
                  <% } else if (c.canal_frecuente === 'manual') { %><span class="pill-manual">Presencial</span>
                  <% } else { %><span class="pill-call">Llamada</span><% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table></div>
      <div id="paginacion" style="display:flex;align-items:center;justify-content:space-between;padding:14px 24px;border-top:1px solid var(--gb);flex-wrap:wrap;gap:8px;"></div>
    </div>
  </main>
  <script>
    function toggleSidebar(){document.getElementById('sidebar').classList.toggle('open');document.getElementById('sidebarOverlay').classList.toggle('open');}
    function closeSidebar(){document.getElementById('sidebar').classList.remove('open');document.getElementById('sidebarOverlay').classList.remove('open');}

    const PAGE_SIZE = 25;
    let paginaActual = 1;
    let filasVisibles = [];

    function filtrarClientes() {
      const q = document.getElementById('buscadorClientes').value.toLowerCase();
      const filas = Array.from(document.querySelectorAll('#tablaClientes tbody tr'));
      filasVisibles = filas.filter(r => {
        const texto = r.textContent.toLowerCase();
        const coincide = !q || texto.includes(q);
        r.style.display = 'none';
        return coincide;
      });
      paginaActual = 1;
      renderPagina();
    }

    function renderPagina() {
      filasVisibles.forEach((r, i) => {
        r.style.display = (i >= (paginaActual-1)*PAGE_SIZE && i < paginaActual*PAGE_SIZE) ? '' : 'none';
      });
      const total = Math.ceil(filasVisibles.length / PAGE_SIZE) || 1;
      document.getElementById('paginacion').innerHTML = total <= 1 ? '' :
        `<span style="font-size:12px;color:var(--t3);">Página ${paginaActual} de ${total} · ${filasVisibles.length} clientes</span>
         <div style="display:flex;gap:6px;">
           <button onclick="cambiarPagina(-1)" ${paginaActual===1?'disabled':''} style="background:var(--glass);border:1px solid var(--gb);color:var(--t2);padding:5px 10px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:12px;">‹ Ant</button>
           <button onclick="cambiarPagina(1)" ${paginaActual===total?'disabled':''} style="background:var(--glass);border:1px solid var(--gb);color:var(--t2);padding:5px 10px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:12px;">Sig ›</button>
         </div>`;
    }

    function cambiarPagina(dir) { paginaActual = Math.max(1, paginaActual + dir); renderPagina(); }

    // Init
    window.addEventListener('DOMContentLoaded', () => {
      filasVisibles = Array.from(document.querySelectorAll('#tablaClientes tbody tr'));
      renderPagina();
    });
  </script>
</body>
</html>
