<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — ReservasBot</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #09090b; color: #e4e4e7; display: flex; min-height: 100vh; }

    .sidebar { width: 240px; background: #0c0c0f; border-right: 1px solid #18181b; display: flex; flex-direction: column; padding: 0; position: fixed; height: 100vh; z-index: 100; }
    .sidebar-logo { padding: 24px 20px 20px; border-bottom: 1px solid #18181b; }
    .sidebar-logo .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .sidebar-logo .brand-icon { width: 32px; height: 32px; background: linear-gradient(135deg, #7c3aed, #4f46e5); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
    .sidebar-logo .brand-name { font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -0.3px; }
    .sidebar-logo .brand-sub { font-size: 11px; color: #7c3aed; padding-left: 42px; font-weight: 600; }
    .sidebar-menu { padding: 12px 10px; flex: 1; }
    .sidebar-section { font-size: 10px; font-weight: 600; color: #3f3f46; text-transform: uppercase; letter-spacing: 1px; padding: 8px 10px 4px; margin-top: 8px; }
    .menu-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; color: #71717a; font-size: 13px; font-weight: 500; cursor: pointer; margin-bottom: 1px; text-decoration: none; transition: all .15s; position: relative; }
    .menu-item:hover { background: #18181b; color: #d4d4d8; }
    .menu-item.active { background: rgba(124,58,237,.12); color: #a78bfa; }
    .menu-item.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; background: linear-gradient(180deg, #7c3aed, #4f46e5); border-radius: 0 3px 3px 0; }
    .menu-icon { font-size: 15px; width: 20px; text-align: center; }
    .sidebar-footer { padding: 14px 16px; border-top: 1px solid #18181b; }
    .logout { color: #52525b; font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px; padding: 6px 0; transition: color .15s; }
    .logout:hover { color: #f87171; }

    .main { margin-left: 240px; flex: 1; padding: 32px; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; }
    .page-header h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: #fafafa; }
    .page-header p { color: #52525b; font-size: 13px; margin-top: 4px; }

    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px; }
    .stat { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 12px; padding: 20px 22px; transition: border-color .2s, transform .2s; }
    .stat:hover { border-color: #2a2a35; transform: translateY(-1px); }
    .stat-label { font-size: 11px; font-weight: 600; color: #52525b; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px; }
    .stat-value { font-size: 32px; font-weight: 700; color: #fafafa; letter-spacing: -1px; }
    .stat-value.accent { background: linear-gradient(135deg, #a78bfa, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-sub { font-size: 12px; color: #3f3f46; margin-top: 4px; }

    .tabla-card { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 12px; overflow: hidden; }
    .tabla-header { padding: 18px 22px; border-bottom: 1px solid #1c1c22; display: flex; justify-content: space-between; align-items: center; }
    .tabla-header h3 { font-size: 14px; font-weight: 600; color: #fafafa; }
    .tabla-count { font-size: 12px; color: #52525b; background: #18181b; padding: 3px 10px; border-radius: 20px; }
    table { width: 100%; border-collapse: collapse; }
    th { color: #52525b; padding: 10px 22px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 600; border-bottom: 1px solid #1c1c22; }
    td { padding: 13px 22px; border-bottom: 1px solid #18181b; font-size: 13px; color: #71717a; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #18181b; }
    .nombre-td { color: #d4d4d8; font-weight: 500; }
    .badge { background: rgba(124,58,237,.1); color: #a78bfa; border: 1px solid rgba(124,58,237,.2); padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge-green { background: rgba(22,163,74,.1); color: #4ade80; border: 1px solid rgba(22,163,74,.2); }
    .badge-red { background: rgba(220,38,38,.08); color: #f87171; border: 1px solid rgba(220,38,38,.2); }
    .empty { text-align: center; padding: 60px; color: #3f3f46; font-size: 14px; }
    .btn-delete { background: none; border: 1px solid #27272a; color: #3f3f46; cursor: pointer; font-size: 13px; padding: 5px 10px; border-radius: 6px; transition: all .15s; font-family: Inter, sans-serif; }
    .btn-delete:hover { background: rgba(248,113,113,.08); color: #f87171; border-color: rgba(248,113,113,.3); }
  </style>
</head>
<body>
  <div class="sidebar">
    <div class="sidebar-logo">
      <div class="brand">
        <div class="brand-icon">🔧</div>
        <div class="brand-name">ReservasBot</div>
      </div>
      <div class="brand-sub">Administración</div>
    </div>
    <div class="sidebar-menu">
      <div class="sidebar-section">Sistema</div>
      <a href="/admin" class="menu-item active"><span class="menu-icon">🏠</span> Dashboard</a>
      <a href="/panel" class="menu-item"><span class="menu-icon">📅</span> Mi panel</a>
    </div>
    <div class="sidebar-footer">
      <a href="/logout" class="logout">↩ Cerrar sesión</a>
    </div>
  </div>

  <div class="main">
    <div class="page-header">
      <div>
        <h1>Panel de Administración</h1>
        <p>Gestión global de ReservasBot</p>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-label">Restaurantes</div>
        <div class="stat-value accent"><%= restaurantes.length %></div>
        <div class="stat-sub">registrados</div>
      </div>
      <div class="stat">
        <div class="stat-label">Reservas totales</div>
        <div class="stat-value"><%= totalReservas %></div>
        <div class="stat-sub">en el sistema</div>
      </div>
      <div class="stat">
        <div class="stat-label">Clientes totales</div>
        <div class="stat-value"><%= totalClientes %></div>
        <div class="stat-sub">registrados</div>
      </div>
      <div class="stat">
        <div class="stat-label">Reservas hoy</div>
        <div class="stat-value"><%= reservasHoy %></div>
        <div class="stat-sub">en curso</div>
      </div>
    </div>

    <div class="tabla-card">
      <div class="tabla-header">
        <h3>Todos los restaurantes</h3>
        <span class="tabla-count"><%= restaurantes.length %> registros</span>
      </div>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Restaurante</th>
            <th>Email</th>
            <th>Número Twilio</th>
            <th>Reservas</th>
            <th>Registro</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if (restaurantes.length === 0) { %>
            <tr><td colspan="7" class="empty">No hay restaurantes registrados</td></tr>
          <% } else { %>
            <% restaurantes.forEach((r, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td class="nombre-td"><%= r.restaurante %></td>
                <td><%= r.email %></td>
                <td>
                  <% if (r.numero_twilio) { %>
                    <span class="badge badge-green"><%= r.numero_twilio %></span>
                  <% } else { %>
                    <span class="badge badge-red">Sin asignar</span>
                  <% } %>
                </td>
                <td><span class="badge"><%= r.total_reservas || 0 %></span></td>
                <td><%= new Date(r.creado_en).toLocaleDateString('es-ES') %></td>
                <td>
                  <form method="POST" action="/admin/restaurante/<%= r.id %>/eliminar" onsubmit="return confirm('Eliminar cuenta de <%= r.restaurante %>?')" style="display:inline;">
                    <button class="btn-delete" type="submit">🗑️ Eliminar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
