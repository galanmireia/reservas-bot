<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: Inter, sans-serif; background: #111; color: #fff; }
.selector { display: flex; gap: 12px; padding: 24px 32px; background: #0a0a0a; border-bottom: 1px solid #222; position: sticky; top: 0; z-index: 100; overflow-x: auto; }
.selector button { padding: 8px 20px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #aaa; cursor: pointer; font-size: 13px; font-family: Inter, sans-serif; white-space: nowrap; transition: all .2s; }
.selector button.active { background: #7c3aed; border-color: #7c3aed; color: #fff; }
.preview { display: none; }
.preview.active { display: flex; height: calc(100vh - 65px); }

/* ─── OPCIÓN 1: Dark SaaS ─── */
.o1 { background: #09090b; color: #fafafa; font-family: Inter, sans-serif; }
.o1 .sidebar { width: 220px; background: #0f0f12; border-right: 1px solid #1c1c22; padding: 24px 0; display: flex; flex-direction: column; }
.o1 .logo { padding: 0 20px 24px; font-size: 15px; font-weight: 600; letter-spacing: -0.3px; color: #fff; border-bottom: 1px solid #1c1c22; margin-bottom: 12px; }
.o1 .logo span { color: #8b5cf6; }
.o1 .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 20px; font-size: 13px; color: #71717a; cursor: pointer; transition: all .15s; border-radius: 0; }
.o1 .nav-item:hover, .o1 .nav-item.active { color: #fafafa; background: #1c1c22; }
.o1 .nav-item.active { border-left: 2px solid #8b5cf6; }
.o1 .nav-icon { width: 16px; opacity: .7; }
.o1 .main { flex: 1; padding: 32px; overflow-y: auto; }
.o1 .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
.o1 h1 { font-size: 20px; font-weight: 600; letter-spacing: -0.5px; }
.o1 .badge { background: #1c1c22; border: 1px solid #2c2c32; color: #a1a1aa; font-size: 11px; padding: 4px 10px; border-radius: 6px; }
.o1 .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px; }
.o1 .stat { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 10px; padding: 18px 20px; }
.o1 .stat-label { font-size: 11px; color: #52525b; text-transform: uppercase; letter-spacing: .8px; margin-bottom: 8px; }
.o1 .stat-val { font-size: 26px; font-weight: 700; letter-spacing: -1px; color: #fafafa; }
.o1 .stat-sub { font-size: 11px; color: #52525b; margin-top: 4px; }
.o1 .stat-accent { color: #8b5cf6; }
.o1 .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.o1 .card { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 10px; padding: 20px; }
.o1 .card-title { font-size: 12px; font-weight: 500; color: #52525b; text-transform: uppercase; letter-spacing: .8px; margin-bottom: 16px; }
.o1 .row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #1c1c22; font-size: 13px; }
.o1 .row:last-child { border-bottom: none; }
.o1 .pill { padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; }
.o1 .pill-green { background: #052e16; color: #4ade80; }
.o1 .pill-purple { background: #2e1065; color: #c4b5fd; }
.o1 .btn { background: #8b5cf6; color: #fff; border: none; padding: 8px 16px; border-radius: 7px; font-size: 13px; font-weight: 500; cursor: pointer; }
.o1 .avatar { width: 28px; height: 28px; background: #2e1065; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: #c4b5fd; margin-top: auto; margin-left: 20px; }

