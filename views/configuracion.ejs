<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configuración — <%= usuario.restaurante %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #09090b; color: #e4e4e7; display: flex; min-height: 100vh; }

    .sidebar { width: 240px; background: #0c0c0f; border-right: 1px solid #18181b; display: flex; flex-direction: column; padding: 0; position: fixed; height: 100vh; z-index: 100; }
    .sidebar-logo { padding: 24px 20px 20px; border-bottom: 1px solid #18181b; }
    .sidebar-logo .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .sidebar-logo .brand-icon { width: 32px; height: 32px; background: linear-gradient(135deg, #7c3aed, #4f46e5); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
    .sidebar-logo .brand-name { font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -0.3px; }
    .sidebar-logo .brand-rest { font-size: 11px; color: #52525b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-left: 42px; }
    .sidebar-menu { padding: 12px 10px; flex: 1; }
    .sidebar-section { font-size: 10px; font-weight: 600; color: #3f3f46; text-transform: uppercase; letter-spacing: 1px; padding: 8px 10px 4px; margin-top: 8px; }
    .menu-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; color: #71717a; font-size: 13px; font-weight: 500; cursor: pointer; margin-bottom: 1px; text-decoration: none; transition: all .15s; position: relative; }
    .menu-item:hover { background: #18181b; color: #d4d4d8; }
    .menu-item.active { background: rgba(124,58,237,.12); color: #a78bfa; }
    .menu-item.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; background: linear-gradient(180deg, #7c3aed, #4f46e5); border-radius: 0 3px 3px 0; }
    .menu-icon { font-size: 15px; width: 20px; text-align: center; }
    .sidebar-footer { padding: 14px 16px; border-top: 1px solid #18181b; }
    .avatar { display: flex; align-items: center; gap: 10px; }
    .avatar-circle { width: 34px; height: 34px; background: linear-gradient(135deg, #7c3aed33, #4f46e533); border: 1px solid #7c3aed44; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #a78bfa; font-weight: 700; font-size: 13px; flex-shrink: 0; }
    .avatar-name { font-size: 12px; font-weight: 500; color: #d4d4d8; }
    .avatar-email { font-size: 11px; color: #52525b; }
    .logout { color: #52525b; font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px; margin-top: 12px; padding: 6px 0; transition: color .15s; }
    .logout:hover { color: #f87171; }

    .main { margin-left: 240px; flex: 1; padding: 32px; max-width: calc(240px + 860px); }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; }
    .page-header h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: #fafafa; }
    .page-header p { color: #52525b; font-size: 13px; margin-top: 4px; }

    .exito { background: rgba(22,163,74,.08); border: 1px solid rgba(22,163,74,.25); color: #4ade80; padding: 12px 16px; border-radius: 8px; margin-bottom: 24px; font-size: 13px; font-weight: 500; }

    .seccion { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 12px; padding: 24px; margin-bottom: 20px; }
    .seccion-title { font-size: 13px; font-weight: 600; color: #d4d4d8; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid #1c1c22; display: flex; align-items: center; gap: 8px; }

    .fila { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .campo { margin-bottom: 16px; }
    .campo label { display: block; font-size: 11px; font-weight: 600; color: #52525b; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; }
    .campo input, .campo textarea, .campo select {
      width: 100%; padding: 10px 13px; background: #09090b; border: 1px solid #27272a;
      border-radius: 8px; font-size: 13px; color: #e4e4e7; outline: none; font-family: Inter, sans-serif;
      transition: border .15s;
    }
    .campo input:focus, .campo textarea:focus, .campo select:focus { border-color: #7c3aed; }
    .campo input::placeholder, .campo textarea::placeholder { color: #3f3f46; }
    .campo textarea { resize: vertical; min-height: 90px; }
    .campo input[readonly] { opacity: 0.4; cursor: not-allowed; }
    .campo select option { background: #0c0c0f; }

    .btn-save {
      padding: 10px 22px; background: linear-gradient(135deg, #7c3aed, #4f46e5); color: white;
      border: none; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600;
      font-family: Inter, sans-serif; letter-spacing: -0.2px; transition: opacity .15s;
    }
    .btn-save:hover { opacity: .88; }

    .mesas-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin-bottom: 20px; }
    .mesa-card {
      background: #09090b; border: 1px solid #27272a; border-radius: 10px; padding: 16px 12px;
      text-align: center; transition: border-color .15s;
    }
    .mesa-card:hover { border-color: #3f3f46; }
    .mesa-num { font-size: 17px; font-weight: 700; background: linear-gradient(135deg, #a78bfa, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .mesa-cap { font-size: 11px; color: #52525b; margin-top: 3px; }
    .btn-del-mesa { margin-top: 10px; background: none; border: 1px solid #27272a; color: #3f3f46; padding: 4px 8px; border-radius: 6px; cursor: pointer; font-size: 11px; width: 100%; font-family: Inter, sans-serif; transition: all .15s; }
    .btn-del-mesa:hover { background: rgba(248,113,113,.08); color: #f87171; border-color: rgba(248,113,113,.3); }

    .add-mesa { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
    .add-mesa .campo { margin: 0; }

    .dia-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #09090b; border: 1px solid #27272a; border-radius: 8px; margin-bottom: 8px; }
    .dia-item span { font-size: 13px; color: #d4d4d8; }
    .dia-motivo { font-size: 12px; color: #52525b; margin-left: 8px; }
    .btn-del-dia { background: none; border: none; color: #3f3f46; cursor: pointer; font-size: 14px; padding: 4px 6px; border-radius: 4px; transition: all .15s; }
    .btn-del-dia:hover { color: #f87171; background: rgba(248,113,113,.08); }
  </style>
</head>
<body>
  <div class="sidebar">
    <div class="sidebar-logo">
      <div class="brand">
        <div class="brand-icon">🤖</div>
        <div class="brand-name">ReservasBot</div>
      </div>
      <div class="brand-rest"><%= usuario.restaurante %></div>
    </div>
    <div class="sidebar-menu">
      <% if (usuario.rol === 'admin') { %>
        <a href="/admin" class="menu-item"><span class="menu-icon">🔧</span> Admin</a>
      <% } %>
      <div class="sidebar-section">Gestión</div>
      <a href="/panel" class="menu-item"><span class="menu-icon">📅</span> Reservas</a>
      <a href="/clientes" class="menu-item"><span class="menu-icon">👥</span> Clientes</a>
      <a href="/configuracion" class="menu-item active"><span class="menu-icon">⚙️</span> Configuración</a>
    </div>
    <div class="sidebar-footer">
      <div class="avatar">
        <div class="avatar-circle"><%= usuario.nombre.charAt(0).toUpperCase() %></div>
        <div style="flex:1;min-width:0;">
          <div class="avatar-name"><%= usuario.nombre %></div>
          <div class="avatar-email"><%= usuario.email %></div>
        </div>
      </div>
      <a href="/logout" class="logout">↩ Cerrar sesión</a>
    </div>
  </div>

  <div class="main">
    <div class="page-header">
      <div>
        <h1>Configuración</h1>
        <p>Personaliza tu restaurante y el comportamiento del bot</p>
      </div>
    </div>

    <% if (exito) { %>
      <div class="exito">✓ Configuración guardada correctamente.</div>
    <% } %>

    <form method="POST" action="/configuracion">
      <div class="seccion">
        <div class="seccion-title">🏪 Información del restaurante</div>
        <div class="fila">
          <div class="campo">
            <label>Nombre del restaurante</label>
            <input type="text" name="restaurante" value="<%= config.restaurante || usuario.restaurante %>" required>
          </div>
          <div class="campo">
            <label>Teléfono</label>
            <input type="text" name="telefono" value="<%= config.telefono || '' %>" placeholder="910 000 000">
          </div>
        </div>
        <div class="campo">
          <label>Dirección</label>
          <input type="text" name="direccion" value="<%= config.direccion || '' %>" placeholder="Calle Mayor 1, Madrid">
        </div>
        <div class="fila">
          <div class="campo">
            <label>Horario</label>
            <input type="text" name="horario" value="<%= config.horario || '' %>" placeholder="Lun-Dom 13:00-16:00 y 20:00-23:30">
          </div>
          <div class="campo">
            <label>Aparcamiento</label>
            <input type="text" name="aparcamiento" value="<%= config.aparcamiento || '' %>" placeholder="Parking público a 200m">
          </div>
        </div>
        <div class="campo">
          <label>Número Twilio asignado</label>
          <input type="text" value="<%= usuario.numero_twilio || 'No asignado' %>" readonly>
        </div>
      </div>

      <div class="seccion">
        <div class="seccion-title">🍽️ Menú</div>
        <div class="campo">
          <label>Descripción del menú</label>
          <textarea name="menu"><%= config.menu || '' %></textarea>
        </div>
        <div class="campo">
          <label>Especialidad</label>
          <input type="text" name="especialidad" value="<%= config.especialidad || '' %>" placeholder="Cocido madrileño los jueves">
        </div>
      </div>

      <button type="submit" class="btn-save">Guardar configuración</button>
    </form>

    <div class="seccion" style="margin-top:20px;">
      <div class="seccion-title">🪑 Mesas</div>
      <div class="mesas-grid">
        <% mesas.forEach(m => { %>
          <div class="mesa-card">
            <div class="mesa-num">Mesa <%= m.numero %></div>
            <div class="mesa-cap"><%= m.capacidad %> personas</div>
            <form method="POST" action="/mesas/eliminar/<%= m.id %>" onsubmit="return confirm('¿Eliminar mesa <%= m.numero %>?')">
              <button type="submit" class="btn-del-mesa">Eliminar</button>
            </form>
          </div>
        <% }) %>
      </div>
      <form method="POST" action="/mesas/añadir" class="add-mesa">
        <div class="campo">
          <label>Número</label>
          <input type="number" name="numero" required min="1" placeholder="6" style="width:80px;">
        </div>
        <div class="campo">
          <label>Capacidad</label>
          <select name="capacidad" style="width:130px;">
            <option value="2">2 personas</option>
            <option value="4">4 personas</option>
            <option value="6">6 personas</option>
            <option value="8">8 personas</option>
          </select>
        </div>
        <button type="submit" class="btn-save" style="height:38px;padding:0 16px;">+ Añadir mesa</button>
      </form>
    </div>

    <div class="seccion" style="margin-top:20px;">
      <div class="seccion-title">🚫 Días cerrados</div>
      <% if (diasCerrados.length > 0) { %>
        <div style="margin-bottom:20px;">
          <% diasCerrados.forEach(d => { %>
            <div class="dia-item">
              <span>
                <% if (d.tipo === 'semana') { %>
                  📅 Todos los <%= ['Domingos','Lunes','Martes','Miércoles','Jueves','Viernes','Sábados'][d.dia_semana] %>
                <% } else if (d.tipo === 'rango') { %>
                  📅 Del <%= new Date(d.fecha).toLocaleDateString('es-ES') %> al <%= new Date(d.fecha_fin).toLocaleDateString('es-ES') %>
                <% } else { %>
                  📅 <%= new Date(d.fecha).toLocaleDateString('es-ES') %>
                <% } %>
                <% if (d.motivo) { %><span class="dia-motivo"><%= d.motivo %></span><% } %>
              </span>
              <form method="POST" action="/dias-cerrados/eliminar/<%= d.id %>">
                <button type="submit" class="btn-del-dia">✕</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p style="font-size:13px;color:#3f3f46;margin-bottom:20px;">No hay días cerrados configurados.</p>
      <% } %>
      <form method="POST" action="/dias-cerrados/anadir" style="display:flex;flex-direction:column;gap:14px;">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
          <div class="campo">
            <label>Tipo</label>
            <select name="tipo" id="tipoCierre" onchange="actualizarFormCierre()" style="width:160px;">
              <option value="fecha">Día específico</option>
              <option value="semana">Día de la semana</option>
              <option value="rango">Rango de fechas</option>
            </select>
          </div>
          <div class="campo" id="campoDia" style="display:none;">
            <label>Día de la semana</label>
            <select name="dia_semana" style="width:140px;">
              <option value="1">Lunes</option>
              <option value="2">Martes</option>
              <option value="3">Miércoles</option>
              <option value="4">Jueves</option>
              <option value="5">Viernes</option>
              <option value="6">Sábado</option>
              <option value="0">Domingo</option>
            </select>
          </div>
          <div class="campo" id="campoFecha">
            <label>Fecha</label>
            <input type="date" name="fecha">
          </div>
          <div class="campo" id="campoFechaFin" style="display:none;">
            <label>Fecha fin</label>
            <input type="date" name="fecha_fin">
          </div>
          <div class="campo">
            <label>Motivo (opcional)</label>
            <input type="text" name="motivo" placeholder="Festivo, vacaciones..." style="width:180px;">
          </div>
          <button type="submit" class="btn-save" style="height:38px;padding:0 16px;">+ Añadir</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function actualizarFormCierre() {
      const tipo = document.getElementById('tipoCierre').value;
      document.getElementById('campoDia').style.display = tipo === 'semana' ? 'flex' : 'none';
      document.getElementById('campoFecha').style.display = tipo === 'semana' ? 'none' : 'flex';
      document.getElementById('campoFechaFin').style.display = tipo === 'rango' ? 'flex' : 'none';
    }
  </script>
</body>
</html>
