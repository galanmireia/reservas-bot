<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel — <%= usuario.restaurante %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #09090b; color: #e4e4e7; display: flex; min-height: 100vh; }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 240px; background: #0c0c0f; border-right: 1px solid #18181b;
      display: flex; flex-direction: column; padding: 0; position: fixed;
      height: 100vh; z-index: 100; transition: transform .3s;
    }
    .sidebar-logo {
      padding: 24px 20px 20px; border-bottom: 1px solid #18181b;
    }
    .sidebar-logo .brand {
      display: flex; align-items: center; gap: 10px; margin-bottom: 6px;
    }
    .sidebar-logo .brand-icon {
      width: 32px; height: 32px; background: linear-gradient(135deg, #7c3aed, #4f46e5);
      border-radius: 8px; display: flex; align-items: center; justify-content: center;
      font-size: 15px; flex-shrink: 0;
    }
    .sidebar-logo .brand-name { font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -0.3px; }
    .sidebar-logo .brand-rest {
      font-size: 11px; color: #52525b; white-space: nowrap; overflow: hidden;
      text-overflow: ellipsis; padding-left: 42px; letter-spacing: 0;
    }
    .sidebar-menu { padding: 12px 10px; flex: 1; }
    .sidebar-section { font-size: 10px; font-weight: 600; color: #3f3f46; text-transform: uppercase;
      letter-spacing: 1px; padding: 8px 10px 4px; margin-top: 8px; }
    .menu-item {
      display: flex; align-items: center; gap: 10px; padding: 9px 12px;
      border-radius: 8px; color: #71717a; font-size: 13px; font-weight: 500;
      cursor: pointer; margin-bottom: 1px; text-decoration: none; transition: all .15s;
      position: relative;
    }
    .menu-item:hover { background: #18181b; color: #d4d4d8; }
    .menu-item.active { background: rgba(124,58,237,.12); color: #a78bfa; }
    .menu-item.active::before {
      content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      width: 3px; height: 20px; background: linear-gradient(180deg, #7c3aed, #4f46e5);
      border-radius: 0 3px 3px 0;
    }
    .menu-icon { font-size: 15px; width: 20px; text-align: center; opacity: .9; }
    .sidebar-footer {
      padding: 14px 16px; border-top: 1px solid #18181b;
    }
    .avatar { display: flex; align-items: center; gap: 10px; }
    .avatar-circle {
      width: 34px; height: 34px; background: linear-gradient(135deg, #7c3aed33, #4f46e533);
      border: 1px solid #7c3aed44; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: #a78bfa; font-weight: 700; font-size: 13px; flex-shrink: 0;
    }
    .avatar-name { font-size: 12px; font-weight: 500; color: #d4d4d8; }
    .avatar-email { font-size: 11px; color: #52525b; }
    .logout {
      color: #52525b; font-size: 11px; text-decoration: none; display: flex;
      align-items: center; gap: 4px; margin-top: 12px; padding: 6px 0;
      transition: color .15s;
    }
    .logout:hover { color: #f87171; }

    /* ── MAIN ── */
    .main { margin-left: 240px; flex: 1; padding: 32px; max-width: calc(100vw - 240px); }

    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; }
    .page-header h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: #fafafa; }
    .page-header p { color: #52525b; font-size: 13px; margin-top: 4px; }
    .header-actions { display: flex; gap: 8px; align-items: center; }

    .btn-secondary {
      display: flex; align-items: center; gap: 6px; padding: 8px 14px;
      background: #18181b; border: 1px solid #27272a; border-radius: 8px;
      color: #a1a1aa; font-size: 12px; font-weight: 500; cursor: pointer;
      text-decoration: none; transition: all .15s; font-family: Inter, sans-serif;
    }
    .btn-secondary:hover { border-color: #3f3f46; color: #e4e4e7; }
    .btn-danger-soft {
      display: flex; align-items: center; gap: 6px; padding: 8px 14px;
      background: #18181b; border: 1px solid #27272a; border-radius: 8px;
      color: #71717a; font-size: 12px; font-weight: 500; cursor: pointer;
      text-decoration: none; transition: all .15s; font-family: Inter, sans-serif;
    }
    .btn-danger-soft:hover { border-color: #f87171; color: #f87171; background: #1a0a0a; }
    .btn-primary {
      display: flex; align-items: center; gap: 6px; padding: 9px 18px;
      background: linear-gradient(135deg, #7c3aed, #4f46e5); border: none;
      border-radius: 8px; color: #fff; font-size: 13px; font-weight: 600;
      cursor: pointer; text-decoration: none; transition: opacity .15s;
      font-family: Inter, sans-serif; letter-spacing: -0.2px;
    }
    .btn-primary:hover { opacity: .88; }

    /* ── STATS ── */
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 28px; }
    .stat {
      background: #0f0f12; border: 1px solid #1c1c22; border-radius: 14px;
      padding: 20px 22px; position: relative; overflow: hidden; transition: border-color .2s;
    }
    .stat:hover { border-color: #2c2c36; }
    .stat::after {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, #7c3aed, #4f46e5); opacity: 0; transition: opacity .2s;
    }
    .stat:hover::after { opacity: 1; }
    .stat-icon { font-size: 22px; margin-bottom: 12px; }
    .stat-label { font-size: 11px; color: #52525b; text-transform: uppercase; letter-spacing: .8px; font-weight: 600; margin-bottom: 6px; }
    .stat-value { font-size: 32px; font-weight: 700; letter-spacing: -1.5px; color: #fafafa; line-height: 1; }
    .stat-value.accent { background: linear-gradient(135deg, #a78bfa, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .stat-sub { font-size: 11px; color: #3f3f46; margin-top: 6px; }

    /* ── CARDS / GRID ── */
    .grid-2 { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; margin-bottom: 24px; }
    .card { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 14px; padding: 22px; }
    .card-title {
      font-size: 11px; font-weight: 600; color: #52525b; text-transform: uppercase;
      letter-spacing: .8px; margin-bottom: 18px; display: flex; align-items: center; gap: 8px;
    }

    /* ── PRÓXIMAS ── */
    .proximas { display: flex; flex-direction: column; gap: 6px; }
    .reserva-item {
      display: flex; align-items: center; gap: 12px; padding: 10px 14px;
      background: #131318; border: 1px solid #1c1c22; border-radius: 10px;
      transition: border-color .15s;
    }
    .reserva-item:hover { border-color: #2c2c36; }
    .reserva-hora {
      font-size: 13px; font-weight: 700; color: #a78bfa; min-width: 46px;
      font-variant-numeric: tabular-nums;
    }
    .reserva-nombre { font-size: 13px; color: #e4e4e7; flex: 1; font-weight: 500; }
    .reserva-personas { font-size: 12px; color: #52525b; }
    .empty-small { text-align: center; padding: 28px; color: #3f3f46; font-size: 13px; }

    /* ── TABLAS ── */
    .tabla-card { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 14px; overflow: hidden; margin-bottom: 24px; }
    .tabla-header {
      padding: 18px 22px; display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid #1c1c22; flex-wrap: wrap; gap: 10px;
    }
    .tabla-title { font-size: 14px; font-weight: 600; color: #e4e4e7; display: flex; align-items: center; gap: 10px; }
    .tabla-controles { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .buscador {
      display: flex; align-items: center; gap: 8px; background: #131318;
      border: 1px solid #1c1c22; border-radius: 8px; padding: 7px 12px; transition: border-color .15s;
    }
    .buscador:focus-within { border-color: #7c3aed; }
    .buscador input { background: none; border: none; outline: none; color: #e4e4e7; font-size: 13px; width: 180px; font-family: Inter, sans-serif; }
    .buscador input::placeholder { color: #3f3f46; }
    .filtro-fecha input {
      padding: 7px 10px; background: #131318; border: 1px solid #1c1c22;
      border-radius: 8px; font-size: 13px; color: #e4e4e7; outline: none;
      transition: border-color .15s; font-family: Inter, sans-serif;
    }
    .filtro-fecha input:focus { border-color: #7c3aed; }
    .btn-filtro {
      padding: 7px 14px; background: #7c3aed; color: white; border: none;
      border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600;
      font-family: Inter, sans-serif; transition: opacity .15s;
    }
    .btn-filtro:hover { opacity: .85; }
    .btn-clear {
      padding: 7px 12px; background: #131318; color: #71717a; border: 1px solid #1c1c22;
      border-radius: 8px; cursor: pointer; font-size: 12px; font-family: Inter, sans-serif; transition: all .15s;
    }
    .btn-clear:hover { border-color: #3f3f46; color: #e4e4e7; }

    table { width: 100%; border-collapse: collapse; }
    th {
      background: #0c0c0f; color: #3f3f46; padding: 10px 18px; text-align: left;
      font-size: 10px; text-transform: uppercase; letter-spacing: .8px; font-weight: 600;
      border-bottom: 1px solid #18181b;
    }
    td { padding: 13px 18px; border-bottom: 1px solid #18181b; font-size: 13px; color: #71717a; }
    tr:last-child td { border-bottom: none; }
    tbody tr { transition: background .1s; }
    tbody tr:hover td { background: #131318; }
    .nombre-td { color: #e4e4e7; font-weight: 500; }

    /* ── PILLS ── */
    .hora-pill {
      background: rgba(124,58,237,.15); color: #a78bfa; padding: 3px 10px;
      border-radius: 6px; font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums;
      border: 1px solid rgba(124,58,237,.2);
    }
    .estado-pill { padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; border: 1px solid transparent; }
    .estado-confirmada { background: rgba(74,222,128,.1); color: #4ade80; border-color: rgba(74,222,128,.15); }
    .estado-pendiente { background: rgba(251,191,36,.1); color: #fbbf24; border-color: rgba(251,191,36,.15); }
    .estado-cancelada { background: rgba(248,113,113,.1); color: #f87171; border-color: rgba(248,113,113,.15); }
    .canal-pill { padding: 3px 9px; border-radius: 6px; font-size: 11px; font-weight: 600; border: 1px solid transparent; }
    .canal-llamada { background: rgba(167,139,250,.1); color: #a78bfa; border-color: rgba(167,139,250,.15); }
    .canal-whatsapp { background: rgba(74,222,128,.1); color: #4ade80; border-color: rgba(74,222,128,.15); }
    .canal-manual { background: #1c1c22; color: #71717a; border-color: #27272a; }
    .espera-badge {
      background: rgba(251,191,36,.1); color: #fbbf24; border: 1px solid rgba(251,191,36,.2);
      padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600;
    }

    /* ── ACCIONES ── */
    .btn-editar {
      background: none; border: none; color: #3f3f46; cursor: pointer;
      font-size: 13px; padding: 5px 8px; border-radius: 6px; transition: all .15s;
    }
    .btn-editar:hover { background: rgba(124,58,237,.15); color: #a78bfa; }
    .btn-cancelar {
      background: none; border: none; color: #3f3f46; cursor: pointer;
      font-size: 13px; padding: 5px 8px; border-radius: 6px; transition: all .15s;
    }
    .btn-cancelar:hover { background: rgba(248,113,113,.12); color: #f87171; }
    .empty { text-align: center; padding: 52px; color: #3f3f46; font-size: 13px; }
    .empty-icon { font-size: 32px; margin-bottom: 12px; opacity: .4; }

    /* ── FORM NUEVA RESERVA ── */
    .form-card { background: #0f0f12; border: 1px solid #1c1c22; border-radius: 14px; padding: 22px; }
    .form-card-title { font-size: 14px; font-weight: 600; color: #e4e4e7; margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }
    .form-grid { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
    .campo { display: flex; flex-direction: column; gap: 6px; }
    .campo label { font-size: 10px; color: #52525b; text-transform: uppercase; letter-spacing: .8px; font-weight: 600; }
    .campo input, .campo select {
      padding: 9px 12px; background: #131318; border: 1px solid #1c1c22;
      border-radius: 8px; font-size: 13px; color: #e4e4e7; outline: none;
      transition: border .15s; font-family: Inter, sans-serif;
    }
    .campo input:focus, .campo select:focus { border-color: #7c3aed; }
    .campo select option { background: #131318; }
    .btn-add {
      padding: 9px 22px; background: linear-gradient(135deg, #7c3aed, #4f46e5);
      color: white; border: none; border-radius: 8px; cursor: pointer;
      font-size: 13px; font-weight: 600; height: 38px; font-family: Inter, sans-serif;
      transition: opacity .15s; letter-spacing: -0.2px;
    }
    .btn-add:hover { opacity: .88; }
    .error-msg {
      background: rgba(248,113,113,.08); border: 1px solid rgba(248,113,113,.2);
      color: #f87171; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px;
      font-size: 13px;
    }

    /* ── MODAL ── */
    .modal-overlay {
      display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,.7); backdrop-filter: blur(4px); z-index: 1000;
      align-items: center; justify-content: center;
    }
    .modal-overlay.active { display: flex; }
    .modal {
      background: #0f0f12; border: 1px solid #27272a; border-radius: 16px;
      padding: 28px; width: 100%; max-width: 440px; box-shadow: 0 24px 60px rgba(0,0,0,.5);
    }
    .modal h3 { font-size: 16px; font-weight: 700; margin-bottom: 6px; color: #fafafa; }
    .modal-sub { font-size: 12px; color: #52525b; margin-bottom: 22px; }
    .modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 22px; }
    .modal-btns { display: flex; gap: 10px; justify-content: flex-end; }
    .btn-modal-cancel {
      padding: 9px 18px; background: #1c1c22; color: #71717a; border: 1px solid #27272a;
      border-radius: 8px; cursor: pointer; font-size: 13px; font-family: Inter, sans-serif; transition: all .15s;
    }
    .btn-modal-cancel:hover { color: #e4e4e7; border-color: #3f3f46; }
    .btn-modal-save {
      padding: 9px 22px; background: linear-gradient(135deg, #7c3aed, #4f46e5);
      color: white; border: none; border-radius: 8px; cursor: pointer;
      font-size: 13px; font-weight: 600; font-family: Inter, sans-serif;
    }

    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0c0c0f; }
    ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
  </style>
</head>
<body>

  <div class="sidebar">
    <div class="sidebar-logo">
      <div class="brand">
        <div class="brand-icon">📅</div>
        <div class="brand-name">ReservasBot</div>
      </div>
      <div class="brand-rest"><%= usuario.restaurante %></div>
    </div>
    <div class="sidebar-menu">
      <% if (usuario.rol === 'admin') { %>
        <div class="sidebar-section">Sistema</div>
        <a href="/admin" class="menu-item"><span class="menu-icon">🔧</span> Administración</a>
      <% } %>
      <div class="sidebar-section">Gestión</div>
      <a href="/panel" class="menu-item active"><span class="menu-icon">📅</span> Reservas</a>
      <a href="/clientes" class="menu-item"><span class="menu-icon">👥</span> Clientes</a>
      <div class="sidebar-section">Ajustes</div>
      <a href="/configuracion" class="menu-item"><span class="menu-icon">⚙️</span> Configuración</a>
    </div>
    <div class="sidebar-footer">
      <div class="avatar">
        <div class="avatar-circle"><%= usuario.nombre.charAt(0).toUpperCase() %></div>
        <div style="flex:1;min-width:0;">
          <div class="avatar-name"><%= usuario.nombre %></div>
          <div class="avatar-email"><%= usuario.email %></div>
        </div>
      </div>
      <a href="/logout" class="logout">← Cerrar sesión</a>
    </div>
  </div>

  <div class="main">
    <div class="page-header">
      <div>
        <h1>Panel de Reservas</h1>
        <p><%= new Date().toLocaleDateString('es-ES', {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'}) %></p>
      </div>
      <div class="header-actions">
        <a href="/exportar-reservas" class="btn-secondary">⬇ Exportar CSV</a>
        <form method="POST" action="/borrar-reservas-pasadas" style="display:inline;" onsubmit="return confirm('¿Borrar reservas pasadas?')">
          <button type="submit" class="btn-danger-soft">🗑 Borrar pasadas</button>
        </form>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-icon">📅</div>
        <div class="stat-label">Reservas hoy</div>
        <div class="stat-value accent"><%= reservasHoy.length %></div>
        <div class="stat-sub">confirmadas para hoy</div>
      </div>
      <div class="stat">
        <div class="stat-icon">👥</div>
        <div class="stat-label">Personas hoy</div>
        <div class="stat-value"><%= reservasHoy.reduce((a, r) => a + (r.personas || 0), 0) %></div>
        <div class="stat-sub">comensales esperados</div>
      </div>
      <div class="stat">
        <div class="stat-icon">📆</div>
        <div class="stat-label">Esta semana</div>
        <div class="stat-value"><%= reservas.filter(r => { const d = new Date(r.fecha); const hoy = new Date(); const diff = (d - hoy) / (1000*60*60*24); return diff >= 0 && diff <= 7; }).length %></div>
        <div class="stat-sub">próximas reservas</div>
      </div>
      <div class="stat">
        <div class="stat-icon">📊</div>
        <div class="stat-label">Total historial</div>
        <div class="stat-value"><%= reservas.length %></div>
        <div class="stat-sub">todas las reservas</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-title">📈 Reservas — últimos 7 días</div>
        <canvas id="grafico" height="130"></canvas>
      </div>
      <div class="card">
        <div class="card-title">⏱ Próximas reservas hoy</div>
        <div class="proximas">
          <% const proximas = reservasHoy.slice().sort((a,b) => a.hora > b.hora ? 1 : -1); %>
          <% if (proximas.length === 0) { %>
            <div class="empty-small">No hay reservas para hoy</div>
          <% } else { %>
            <% proximas.slice(0, 5).forEach(r => { %>
              <div class="reserva-item">
                <span class="reserva-hora"><%= r.hora %></span>
                <span class="reserva-nombre"><%= r.nombre %></span>
                <span class="reserva-personas"><%= r.personas %> pers.</span>
              </div>
            <% }) %>
            <% if (proximas.length > 5) { %>
              <div style="text-align:center;font-size:12px;color:#3f3f46;margin-top:8px;">+<%= proximas.length - 5 %> más hoy</div>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- LISTA DE ESPERA -->
    <div class="tabla-card">
      <div class="tabla-header">
        <div class="tabla-title">
          ⏳ Lista de espera
          <span class="espera-badge"><%= listaEspera.length %> personas</span>
        </div>
      </div>
      <% if (listaEspera.length === 0) { %>
        <div class="empty"><div class="empty-icon">⏳</div>No hay nadie en lista de espera</div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Teléfono</th>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Personas</th>
              <th>Estado</th>
              <th>Apuntado</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% listaEspera.forEach(l => { %>
              <tr>
                <td class="nombre-td"><%= l.nombre %></td>
                <td><%= l.telefono %></td>
                <td><%= l.fecha %></td>
                <td><span class="hora-pill"><%= l.hora %></span></td>
                <td><%= l.personas %> pers.</td>
                <td><span class="estado-pill <%= l.estado === 'notificado' ? 'estado-pendiente' : 'estado-confirmada' %>"><%= l.estado || 'esperando' %></span></td>
                <td><%= new Date(l.creada_en).toLocaleDateString('es-ES') %></td>
                <td>
                  <form method="POST" action="/espera/eliminar/<%= l.id %>" style="display:inline;">
                    <button class="btn-cancelar" type="submit" onclick="return confirm('¿Eliminar de lista de espera?')">✕</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- TODAS LAS RESERVAS -->
    <div class="tabla-card">
      <div class="tabla-header">
        <div class="tabla-title">📋 Todas las reservas</div>
        <div class="tabla-controles">
          <div class="buscador">
            <span style="color:#3f3f46;font-size:13px;">🔍</span>
            <input type="text" id="buscador" placeholder="Buscar por nombre..." oninput="filtrarTabla()">
          </div>
          <div class="filtro-fecha" style="display:flex;gap:8px;">
            <input type="date" id="filtroFecha" value="<%= fechaFiltro || '' %>">
            <button class="btn-filtro" onclick="filtrar()">Filtrar</button>
            <button class="btn-clear" onclick="limpiar()">✕</button>
          </div>
        </div>
      </div>
      <table id="tablaReservas">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Personas</th>
            <th>Canal</th>
            <th>Estado</th>
            <th>Notas</th>
            <th>Recibida</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% const listaReservas = fechaFiltro ? reservasFiltradas : reservas; %>
          <% if (listaReservas.length === 0) { %>
            <tr><td colspan="9" class="empty"><div class="empty-icon">📋</div>No hay reservas todavía</td></tr>
          <% } else { %>
            <% listaReservas.forEach(r => { %>
              <tr>
                <td class="nombre-td"><%= r.nombre %></td>
                <td><%= r.fecha %></td>
                <td><span class="hora-pill"><%= r.hora %></span></td>
                <td><%= r.personas %> pers.</td>
                <td>
                  <% if (r.canal === 'whatsapp') { %>
                    <span class="canal-pill canal-whatsapp">WhatsApp</span>
                  <% } else if (r.canal === 'manual') { %>
                    <span class="canal-pill canal-manual">Presencial</span>
                  <% } else { %>
                    <span class="canal-pill canal-llamada">Llamada</span>
                  <% } %>
                </td>
                <td><span class="estado-pill estado-<%= r.estado || 'confirmada' %>"><%= r.estado || 'confirmada' %></span></td>
                <td><% if (r.notas) { %><span style="color:#fbbf24;font-size:12px;" title="<%= r.notas %>">⚠️ <%= r.notas.length > 30 ? r.notas.substring(0,30)+'…' : r.notas %></span><% } else { %><span style="color:#27272a;font-size:12px;">—</span><% } %></td>
                <td><%= new Date(r.creada_en).toLocaleDateString('es-ES') %></td>
                <td style="white-space:nowrap;">
                  <button class="btn-editar" onclick="abrirEditar('<%= r.id %>', '<%= r.nombre %>', '<%= r.fecha %>', '<%= r.hora %>', '<%= r.personas %>')" type="button">✏️</button>
                  <form method="POST" action="/cancelar/<%= r.id %>" onsubmit="return confirm('¿Cancelar reserva de <%= r.nombre %>?')" style="display:inline;">
                    <button class="btn-cancelar" type="submit">✕</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="form-card">
      <div class="form-card-title">✚ Añadir reserva manual</div>
      <% if (error === 'fecha') { %><div class="error-msg">⚠ La fecha y hora ya han pasado.</div><% } %>
      <% if (error === 'cupo') { %><div class="error-msg">⚠ No hay mesas disponibles para esa fecha, hora y número de personas.</div><% } %>
      <% if (error === 'telefono') { %><div class="error-msg">⚠ El teléfono es obligatorio.</div><% } %>
      <form method="POST" action="/nueva-reserva" class="form-grid">
        <div class="campo">
          <label>Nombre</label>
          <input name="nombre" required placeholder="Nombre cliente" style="width:150px;">
        </div>
        <div class="campo">
          <label>Teléfono</label>
          <div style="display:flex;gap:6px;">
            <select name="prefijo" style="width:80px;">
              <option value="+34">🇪🇸 +34</option>
              <option value="+1">🇺🇸 +1</option>
              <option value="+44">🇬🇧 +44</option>
              <option value="+33">🇫🇷 +33</option>
            </select>
            <input name="telefono" required placeholder="600000000" pattern="[0-9]{9}" style="width:120px;">
          </div>
        </div>
        <div class="campo">
          <label>Fecha</label>
          <input name="fecha" type="date" required style="width:140px;">
        </div>
        <div class="campo">
          <label>Hora</label>
          <input name="hora" type="time" required style="width:110px;">
        </div>
        <div class="campo">
          <label>Personas</label>
          <input name="personas" type="number" min="1" max="20" required placeholder="2" style="width:70px;">
        </div>
        <div class="campo">
          <label>Notas</label>
          <input name="notas" placeholder="Alergias, vegano, cumpleaños..." style="width:200px;">
        </div>
        <button type="submit" class="btn-add">+ Añadir</button>
      </form>
    </div>
  </div>

  <!-- MODAL EDITAR -->
  <div class="modal-overlay" id="modalEditar" onclick="if(event.target===this)cerrarEditar()">
    <div class="modal">
      <h3>Editar reserva</h3>
      <div class="modal-sub">Modifica los datos de la reserva seleccionada</div>
      <form method="POST" id="formEditar">
        <div class="modal-grid">
          <div class="campo">
            <label>Nombre</label>
            <input type="text" name="nombre" id="editNombre" required>
          </div>
          <div class="campo">
            <label>Personas</label>
            <input type="number" name="personas" id="editPersonas" min="1" max="20" required>
          </div>
          <div class="campo">
            <label>Fecha</label>
            <input type="date" name="fecha" id="editFecha" required>
          </div>
          <div class="campo">
            <label>Hora</label>
            <input type="time" name="hora" id="editHora" required>
          </div>
        </div>
        <div class="modal-btns">
          <button type="button" class="btn-modal-cancel" onclick="cerrarEditar()">Cancelar</button>
          <button type="submit" class="btn-modal-save">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function filtrar() {
      const fecha = document.getElementById('filtroFecha').value;
      if (fecha) window.location.href = '/panel?fecha=' + fecha;
    }
    function limpiar() { window.location.href = '/panel'; }
    function filtrarTabla() {
      const texto = document.getElementById('buscador').value.toLowerCase();
      document.querySelectorAll('#tablaReservas tbody tr').forEach(fila => {
        const nombre = fila.cells[0]?.textContent.toLowerCase() || '';
        fila.style.display = nombre.includes(texto) ? '' : 'none';
      });
    }
    function abrirEditar(id, nombre, fecha, hora, personas) {
      document.getElementById('editNombre').value = nombre;
      document.getElementById('editFecha').value = fecha;
      document.getElementById('editHora').value = hora;
      document.getElementById('editPersonas').value = personas;
      document.getElementById('formEditar').action = '/editar-reserva/' + id;
      document.getElementById('modalEditar').classList.add('active');
    }
    function cerrarEditar() {
      document.getElementById('modalEditar').classList.remove('active');
    }

    // Chart
    const reservas = <%- JSON.stringify(reservas.map(r => ({ fecha: r.fecha }))) %>;
    const labels = [], datos = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const fecha = d.toISOString().split('T')[0];
      labels.push(d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric' }));
      datos.push(reservas.filter(r => r.fecha === fecha).length);
    }
    new Chart(document.getElementById('grafico'), {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          data: datos,
          backgroundColor: 'rgba(124,58,237,.25)',
          borderColor: '#7c3aed',
          borderWidth: 1.5,
          borderRadius: 6,
          hoverBackgroundColor: 'rgba(124,58,237,.4)'
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false }, tooltip: {
          backgroundColor: '#1c1c22', titleColor: '#e4e4e7', bodyColor: '#a1a1aa',
          borderColor: '#27272a', borderWidth: 1, padding: 10,
          callbacks: { label: ctx => ` ${ctx.parsed.y} reserva${ctx.parsed.y !== 1 ? 's' : ''}` }
        }},
        scales: {
          x: { grid: { color: '#18181b' }, ticks: { color: '#52525b', font: { size: 11, family: 'Inter' } } },
          y: { grid: { color: '#18181b' }, ticks: { color: '#52525b', stepSize: 1, font: { size: 11, family: 'Inter' } } }
        }
      }
    });
  </script>
</body>
</html>
